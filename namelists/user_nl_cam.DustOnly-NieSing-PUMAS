! Users should add all user specific namelist changes below in the form of 
! namelist_var = new_namelist_value 
 
! Microphysics process factors

hclas_du_imm = 1
riming_factor = 1
auto_liq_factor = 1
micro_mg_ice_berg_ice_factor = 1
micro_mg_ice_berg_snow_factor = 1

!----------------------------------------------------------
! Nudging configuration: ERA5 winds only (U, V)
!----------------------------------------------------------
Nudge_Model    = .true.
Nudge_Path     = '/path/to/ERA5_nudging_files/'
Nudge_File_Template = 'ERA5_x_fv1x1_L32_rgC2_WO.%y-%m-%d-%s.nc'

Nudge_Times_Per_Day = 4

! Wind nudging ON (reduced strength to avoid aerosol instability)
Nudge_Uprof  = 1
Nudge_Ucoef  = 1
Nudge_Vprof  = 1
Nudge_Vcoef  = 1

! T, Q, PS nudging OFF
Nudge_Tprof  = 0
Nudge_Tcoef  = 0.0
Nudge_Qprof  = 0
Nudge_Qcoef  = 0.0
Nudge_PSprof = 0
Nudge_PScoef = 0.0

! Date range: adjust to the simulation period
Nudge_Beg_Year  = 2000
Nudge_Beg_Month = 1
Nudge_Beg_Day   = 1
Nudge_End_Year  = 2025
Nudge_End_Month = 12
Nudge_End_Day   = 31

! Nudge globally, entire column
Nudge_Hwin_lat0     = 0.0
Nudge_Hwin_latWidth = 999.0
Nudge_Hwin_latDelta = 0.1
Nudge_Hwin_lon0     = 180.0
Nudge_Hwin_lonWidth = 999.0
Nudge_Hwin_lonDelta = 0.1
Nudge_Vwin_Lindex   = 0.0
Nudge_Vwin_Ldelta   = 0.001
Nudge_Vwin_Hindex   = 33.0
Nudge_Vwin_Hdelta   = 0.001

! Linear interpolation in time between nudging files
Nudge_Force_Opt = 1 ! LINEAR
! Weak relaxation time scale
Nudge_TimeScale_Opt  = 0      ! WEAK
! Update nudging every model step (CAM dt = 1800 s)
Model_Times_Per_Day  = 48

!----------------------------------------------------------
! Microphysics & output 
!----------------------------------------------------------
! namelist group micro_dv_nl, defined in src/physics/cam/micro_dv_nml.F90

factor_HM = 0
onoff_sip = .false. 

depr_point_frz = .false.      ! avoid solubility effect deactivating 
			      ! freezing for warmer temperatures

! Droplet freezing limiter and Niemand singular dust immersion freezing

enable_nimax = .false.
limfacdu = 0.051                     ! maximum dust fraction that may freeze per call
limfacdu_niemand_singular = .true.
limfacdu_niemand_factor = 1.0
limfacdu_niemand_max = 100.0

micro_mg_num_steps = 8                ! see 10.1029/2021MS002776
naai_het_also_in_mpc = .false.       ! cirrus ice nucleation not applied in mixed-phase clouds

! Dust immersion freezing as the only heterogeneous mixed-phase ice source


hclas_du_dep = 0.0
hclas_du_cnt = 0.0                      
hclas_bc_imm = 0.0                      
hclas_bc_dep = 0.0                      
hclas_bc_cnt = 0.0                      

onoff_contact_freezing = .false.       ! no contact freezing
rain_freeze = .false.                   ! no rain freezing
detrainment_ramp_liq = .true.              ! detrained condensate as liquid (CLUBB)


!!         h0   h1   h2   h3  h4
nhtfrq   = 0, -24, -24 , -24, -1
mfilt    = 1,   1,    1 , 1,  48
! h0: monthly, h1-h3: daily, h4: hourly precipitation

fincl1 = 'CLD_CAL_TMPICE:A','CLD_CAL_TMPLIQ:A','CLD_CAL_TMPUN:A','CLD_CAL_TMP:A',
         'AODVIS:A','AODDUST:A','AODSO4:A','AODBC:A','AODPOM:A','AODSOA:A','AODSS:A',
         'CLDICE:A','CLDLIQ:A','T:A','CLDTOP:A','QSNOW:A','QRAIN:A',
         'ACTNI:A','ACTNL:A','ACTREI:A','ACTREL:A','FCTL:A','FCTI:A',
         'LWCF:A','SWCF:A','FSNT:A','FSNTC:A','FLNT:A','FLNTC:A',
         'FLNS:A','FLNSC:A','FSNS:A','FSNSC:A',
         'TGCLDIWP:A','TGCLDLWP:A',
         'CDNUMC:A','ICNUMC:A','SCNUMC:A','RDNUMC:A',
         'CDMASS:A','ICMASS:A','SCMASS:A','RDMASS:A',
         'BERGO_PATH:A','BERGSO_PATH:A','QCTEN_PATH:A','QINTEN_PATH:A',
         'NCTEN_PATH:A','NINTEN_PATH:A','QRTEN_PATH:A','QSTEN_PATH:A',
         'NRTEN_PATH:A','NSTEN_PATH:A',
         'FRZIMM_PATH:A','FRZCNT_PATH:A','FRZDEP_PATH:A',
         'PRAO_PATH:A','PSACWSO_PATH:A','PRAIO_PATH:A','PRCO_PATH:A',
         'PRCIO_PATH:A','PRACSO_PATH:A','MELTO_PATH:A',
         'QCSEVAP_PATH:A','QISEVAP_PATH:A','CMEIOUT_PATH:A',
         'EVPRAIN_ST_PATH:A','EVPSNOW_ST_PATH:A',
         'CLDTOT_CAL:A','PRECT:A','PRECL:A'

!
!
! h1: daily vertical profiles of cloud ice and liquid mass
!
fincl2   = 'CLDICE:I','CLDLIQ:I','T:I','CLDTOP:I','QSNOW:I','QRAIN:I'

!
! h2: daily 2-D fields
!
fincl3   = 'CLDTOP:I','ACTNI:I','ACTNL:I','ACTREI:I','ACTREL:I','FCTL:I','FCTI:I','LWCF:A','SWCF:A','FSNT:A','FSNTC:A','FLNT:A','FLNTC:A','FLNS:A','FLNSC:A','FSNS:A','FSNSC:A','TGCLDIWP:I','TGCLDLWP:I','CDNUMC:I','ICNUMC:I','SCNUMC:I','RDNUMC:I','CDMASS:I','ICMASS:I','SCMASS:I','RDMASS:I','BERGO_PATH:I','BERGSO_PATH:I','QCTEN_PATH:I','QINTEN_PATH:I','NCTEN_PATH:I','NINTEN_PATH:I','QRTEN_PATH:I','QSTEN_PATH:I','NRTEN_PATH:I','NSTEN_PATH:I','FRZIMM_PATH:I','FRZCNT_PATH:I','FRZDEP_PATH:I','PRAO_PATH:I','PSACWSO_PATH:I','PRAIO_PATH:I','PRCO_PATH:I','PRCIO_PATH:I','PRACSO_PATH:I','MELTO_PATH:I','QCSEVAP_PATH:I','QISEVAP_PATH:I','CMEIOUT_PATH:I','EVPRAIN_ST_PATH:I','EVPSNOW_ST_PATH:I'
!
! h3: daily COSP CALIPSO fields
!
fincl4   = 'CLD_CAL_TMPICE:A','CLD_CAL_TMPLIQ:A','CLDTOT_CAL:A'
!

! h4: hourly precipitation
fincl5   = 'PRECT:I','PRECL:I'

! Select PUMAS microphysics (micro_mg_version = 3); the settings above are those of the original MG2 run DustOnly-NieSing
 micro_mg_version = 3
 micro_mg_sub_version = 0
